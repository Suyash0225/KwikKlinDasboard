# Safe environment for the EC2 development server.
# Copy to .env.dev. NEVER put production secrets here.
#
# This server listens on port 8001 and uses Postgres on localhost:5433.
# WhatsApp is intentionally pointed at Meta with dummy credentials so this
# development instance cannot use the production WAHA session.

DATABASE_URL=postgresql+asyncpg://laundry_dev:laundry_dev@localhost:5433/laundry_dev
APP_DATABASE_URL=

WHATSAPP_PROVIDER=meta
WAHA_BASE_URL=http://127.0.0.1:3999
WAHA_API_KEY=
WAHA_SESSION=dev
WAHA_WEBHOOK_HMAC_KEY=

WHATSAPP_TOKEN=dev-placeholder
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_VERIFY_TOKEN=dev-placeholder
WHATSAPP_APP_SECRET=00000000000000000000000000000000

LLM_PROVIDER=gemini
GEMINI_API_KEY=

MANAGER_PHONE=+919999900099
WHATSAPP_WABA_ID=
WHATSAPP_APP_ID=
ESCALATION_CC_PHONE=

ADMIN_API_KEY=dev-admin-key
VENDOR_API_KEY=dev-vendor-key
TOKEN_ENCRYPTION_KEY=

DOTPE_API_KEY=
DOTPE_WABA_NUMBER=
DOTPE_WEBHOOK_TOKEN=

SHOP_NAME=Kwik Klin Dev
DEFAULT_COUNTRY_CODE=91

QUIET_HOURS_START=21
QUIET_HOURS_END=9
FOLLOWUP_DAYS=14

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

APP_BASE_URL=http://127.0.0.1:8001
SITE_URL=http://127.0.0.1:8001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONTROL_GOOGLE_ALLOWED_EMAILS=
CONTROL_GOOGLE_LEVEL=read
CONTROL_GOOGLE_BASE_URL=http://127.0.0.1:8001/control

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

ENVIRONMENT=development
RATE_LIMIT_PER_MIN=600
LOG_LEVEL=DEBUG
