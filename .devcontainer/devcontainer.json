{
  "name": "Kwik Klin",

  // Python 3.12 — wahi jis par app aur test chalte hain.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    // Postgres docker-compose se aata hai, isliye container ke andar
    // docker chahiye.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // onCreateCommand PREBUILD ke waqt chalta hai (agar prebuild on ho),
  // isliye bhaari aur ek-baar wala kaam yahan: dependencies.
  // postCreateCommand har naye Codespace par chalta hai.
  "onCreateCommand": "pip install --no-cache-dir -r requirements.txt",

  // Yahan sirf wo cheezein jo har Codespace ki apni hain — .env ki keys
  // aur DB ka apna role. Ye prebuild mein bake NAHI honi chahiye: prebuild
  // sab ke liye ek hi image hai, aur usmein secrets nahi jaane chahiye.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Kwik Klin",
      // Phone par kholna aam zaroorat hai (staff panel), aur har restart par
      // haath se Public karna bhoolne wali cheez hai.
      "visibility": "public",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
