# Copy this file to .env and fill in real values.
#
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# .env is gitignored. NEVER commit real tokens.
# The dummy values below are enough to boot the app in Phase 1 — nothing
# calls WhatsApp or Anthropic yet.

# --- Database ---
# Matches the credentials in docker-compose.yml. Change host/port if you run
# Postgres natively. The +asyncpg driver is required.
# Owner role — MIGRATIONS isse chalti hain (DDL ke liye superuser chahiye).
DATABASE_URL=postgresql+asyncpg://laundry:laundry@localhost:5432/laundry
# APP ka role — NOSUPERUSER. RLS SIRF iske upar sach mein lagti hai:
# superuser par row-level security laagu hoti hi nahi, aur docker-compose ka
# POSTGRES_USER bootstrap superuser hota hai. Khali chhod doge to app chalegi
# (DATABASE_URL se) par tenant isolation akele ORM filter par tik jayegi.
#   python -m scripts.create_app_role
APP_DATABASE_URL=

# --- WhatsApp Cloud API (Meta Graph API v21.0+) ---
# From: developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WhatsApp Business Account id (same page, upar). Iske bina dashboard ka
# template count aur quality rating khali rehte hain — baaki sab chalta hai.
WHATSAPP_WABA_ID=
# You invent this one. Meta sends it back to you during webhook verification.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string
# From: your app -> Settings -> Basic -> App Secret
WHATSAPP_APP_SECRET=00000000000000000000000000000000
# Meta App ID — APP_SECRET ke bilkul saath, usi App dashboard page par upar.
# Iske bina do cheezein chup ho jaati hain: webhook subscription ka
# self-healing (tunnel_guard), aur /control ka WhatsApp health check
# subscription ko "pata nahi" dikhata hai.
WHATSAPP_APP_ID=

# --- LLM (not used until Phase 4) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- People ---
# Your own WhatsApp number, E.164 format, with the + and country code.
MANAGER_PHONE=+919876543210

# --- Keys & secrets ---
#
# Teeno alag-alag honi chahiye. Ek hi baar banao, phir .env ka backup rakho
# (khaas kar TOKEN_ENCRYPTION_KEY — wo kho gayi to DB ke encrypted tokens
# wapas nahi milenge, har dukaan ko WhatsApp dobara connect karna padega).
#
# Teeno ek saath generate karne ke liye ye chala kar output yahan chipka do:
#
#   python -c "
#   from cryptography.fernet import Fernet
#   import secrets
#   print('ADMIN_API_KEY=' + secrets.token_urlsafe(32))
#   print('VENDOR_API_KEY=' + secrets.token_urlsafe(32))
#   print('TOKEN_ENCRYPTION_KEY=' + Fernet.generate_key().decode())
#   "
#
# Windows (cmd) par ek line mein:
#   python -c "from cryptography.fernet import Fernet; import secrets; print('ADMIN_API_KEY=' + secrets.token_urlsafe(32)); print('VENDOR_API_KEY=' + secrets.token_urlsafe(32)); print('TOKEN_ENCRYPTION_KEY=' + Fernet.generate_key().decode())"

# Dukaan ka key — X-API-Key header, /admin ke endpoints par.
ADMIN_API_KEY=change-me-to-a-long-random-string

# Vendor (platform) ka key — sirf /control panel aur uski session cookie.
# ADMIN_API_KEY se ALAG rakho: ek leak par dono nahi khulne chahiye.
# Khali chhoda to ADMIN_API_KEY hi chalega (purana behaviour + warning).
VENDOR_API_KEY=

# Har dukaan ka WhatsApp token DB mein isse encrypt hota hai (Fernet).
# Khali = plaintext + startup warning. Rotate mat karo — purani rows purani
# key se hi khulti hain. Set karne ke baad ek baar:
#   python -m scripts.encrypt_tokens
TOKEN_ENCRYPTION_KEY=

# --- DotPe BSP (optional — sirf tab jab WHATSAPP_PROVIDER=dotpe ho) ---
# Meta Cloud API default hai; DotPe ek alternate BSP hai. Teeno khali =
# DotPe band (webhook har request par 403 deta hai, jo sahi hai).
# DotPe merchant panel -> API section se.
DOTPE_API_KEY=
# WABA number, digits + country code, bina '+' — e.g. 917644020285
DOTPE_WABA_NUMBER=
# Ye value DotPe ke panel mein custom webhook header ke roop mein daalo.
# Bina iske aane wali request 403 hoti hai.
DOTPE_WEBHOOK_TOKEN=

# --- Shop / locale ---
SHOP_NAME=Kwik Klin
# Country code without the '+'. Used to normalise local numbers to E.164.
DEFAULT_COUNTRY_CODE=91

# --- Scheduling behaviour ---
# No proactive messages sent between these hours (24h local time).
QUIET_HOURS_START=21
QUIET_HOURS_END=9
# Days of customer silence before a follow-up message.
FOLLOWUP_DAYS=14

# --- Runtime ---
# development | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# pg_dump ka path (nightly backups) - default Windows PG15 install
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\15\bin\pg_dump.exe

# ── Ye sab optional hain, par code inhe padhta hai ──────────────────────
# Yahan isliye likhe hain ki "kya-kya set kiya ja sakta hai" ka jawab
# config.py padhe bina mile. Khali chhodne par feature bas chup rehta
# hai — app phir bhi chalti hai.

# Payments (Razorpay). Teenon chahiye, warna checkout trial par rukta hai.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# "Sign in with Google" — dono khali to wo button kaam nahi karta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI: LLM_PROVIDER = anthropic (default) ya gemini.
LLM_PROVIDER=
GEMINI_API_KEY=

# Har escalation alert ki copy is number par bhi (khali = sirf owner).
ESCALATION_CC_PHONE=

# WHATSAPP_PROVIDER = meta (default) ya dotpe.
WHATSAPP_PROVIDER=

# Public URL ka fallback jab settings_kv khali ho. Aam taur par zaroorat
# nahi — asli value dashboard/scripts.set_public_url se aati hai.
APP_BASE_URL=

# Per-IP request limit. Khali = code ka default.
RATE_LIMIT_PER_MIN=

# pg_dump ka poora path, agar PATH mein na ho (Windows par aksar).
PG_DUMP_PATH=
