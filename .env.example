# Copy this file to .env and fill in real values.
#
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# .env is gitignored. NEVER commit real tokens.
# The dummy values below are enough to boot the app in Phase 1 — nothing
# calls WhatsApp or Anthropic yet.

# --- Database ---
# Matches the credentials in docker-compose.yml. Change host/port if you run
# Postgres natively. The +asyncpg driver is required.
DATABASE_URL=postgresql+asyncpg://laundry:laundry@localhost:5432/laundry

# --- WhatsApp Cloud API (Meta Graph API v21.0+) ---
# From: developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# You invent this one. Meta sends it back to you during webhook verification.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string
# From: your app -> Settings -> Basic -> App Secret
WHATSAPP_APP_SECRET=00000000000000000000000000000000

# --- LLM (not used until Phase 4) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- People ---
# Your own WhatsApp number, E.164 format, with the + and country code.
MANAGER_PHONE=+919876543210

# --- Internal admin API ---
# You invent this one. Sent as the X-API-Key header on admin endpoints.
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Shop / locale ---
SHOP_NAME=Kwik Klin
# Country code without the '+'. Used to normalise local numbers to E.164.
DEFAULT_COUNTRY_CODE=91

# --- Scheduling behaviour ---
# No proactive messages sent between these hours (24h local time).
QUIET_HOURS_START=21
QUIET_HOURS_END=9
# Days of customer silence before a follow-up message.
FOLLOWUP_DAYS=14

# --- Runtime ---
# development | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# pg_dump ka path (nightly backups) - default Windows PG15 install
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\15\bin\pg_dump.exe
